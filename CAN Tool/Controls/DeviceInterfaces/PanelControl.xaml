<UserControl x:Class="CAN_Tool.CustomControls.PanelControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CAN_Tool.CustomControls"
             xmlns:op="clr-namespace:OmniProtocol"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=op:PanelDeviceViewModel}">
    <DockPanel>
        <local:DeviceHeaderControl DockPanel.Dock="Top" />

        <!-- У пульта нет собственных параметров - он и есть ПУ28, работающий в обычном режиме,
             поэтому те же кнопки управления внешней flash-микросхемой, что и на странице
             загрузчика (см. Pu28MemoryControl.xaml, Pu28DeviceViewModel.cs). -->
        <local:Pu28MemoryControl DockPanel.Dock="Top" />
    </DockPanel>
</UserControl>
