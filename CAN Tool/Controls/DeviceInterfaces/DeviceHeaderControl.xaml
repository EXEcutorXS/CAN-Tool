<UserControl x:Class="CAN_Tool.CustomControls.DeviceHeaderControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:op="clr-namespace:OmniProtocol"
             mc:Ignorable="d"
             d:DesignHeight="140" d:DesignWidth="900"
             d:DataContext="{d:DesignInstance Type=op:DeviceViewModel}">
    <!--
        Единый блок "шапки" устройства - раньше изображение/версия/серийник/дата были
        продублированы в каждой странице устройства по-своему. Теперь один компонент,
        встраиваемый везде (HeaterControl, HcuOmniControl, AcInverterControl, AcPanelControl,
        GenericLoadTrippleControl, PressureSensorControl, ModemControl, BootloaderControl).

        To Bootloader/Auto Update работают через DeviceViewModel.SwitchToBootLoaderCommand /
        AutoUpdateFirmwareCommand - они сами определяют, нужно ли сначала переводить устройство
        в загрузчик, или оно уже там (см. DeviceViewModel.RunAutoUpdate). На странице загрузчика
        (CanEnterBootloader=false там) из шапки убраны "To Bootloader" (уже некуда входить),
        Auto Update и выбор прошивки с сервера - там уже есть свой набор конкретных кнопок
        "Прошить" под фактическое поколение загрузчика (см. BootloaderControl.xaml), и держать
        рядом ещё и Auto/комбобокс избыточно.

        Комбобокс выбора прошивки с сервера - список версий подтягивается с multihot.online
        по типу устройства (DeviceViewModel.RefreshAvailableServerFirmwares), выбор версии
        скачивает и подставляет её как fragments - дальше жмём Auto Update/Burn как обычно
        (см. DeviceViewModel.OnSelectedServerFirmwareChanged, Libs/OnlineFirmwareService.cs).
    -->
    <WrapPanel Margin="5">
        <Border CornerRadius="15" Margin="5" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="2" Width="100" Height="100">
            <Border.Background>
                <ImageBrush ImageSource="{Binding Img}" Stretch="Fill" />
            </Border.Background>
        </Border>
        <StackPanel VerticalAlignment="Center" Margin="10,0">
            <TextBlock Text="{Binding Firmware, Converter={StaticResource VersionConverter}, Mode=OneWay}" FontSize="18" />
            <TextBlock Text="{Binding Serial, Converter={StaticResource VersionConverter}, Mode=OneWay}" FontSize="18" />
            <TextBlock Text="{Binding ProductionDate, Mode=OneWay}" FontSize="18" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="10,0"
                    Visibility="{Binding CanEnterBootloader, Converter={StaticResource BoolToVisibileConverter}}">
            <Button Content="{DynamicResource b_switch_to_boot}" Margin="3" Command="{Binding SwitchToBootLoaderCommand}" />
            <Button Content="{DynamicResource b_auto_update}" Margin="3" Command="{Binding AutoUpdateFirmwareCommand}" />
        </StackPanel>
        <StackPanel VerticalAlignment="Center" Margin="10,0"
                    Visibility="{Binding CanEnterBootloader, Converter={StaticResource BoolToVisibileConverter}}">
            <TextBlock Text="{DynamicResource t_online_firmware}" FontSize="11" Opacity="0.6" Margin="3,0,3,2" />
            <ComboBox Width="220" Margin="3,0"
                      ItemsSource="{Binding AvailableServerFirmwares}"
                      SelectedItem="{Binding SelectedServerFirmware}" />
        </StackPanel>
    </WrapPanel>
</UserControl>
