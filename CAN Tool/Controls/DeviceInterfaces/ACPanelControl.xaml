<UserControl x:Class="CAN_Tool.CustomControls.AcPanelControl" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" xmlns:d="http://schemas.microsoft.com/expression/blend/2008" xmlns:local="clr-namespace:CAN_Tool.CustomControls" xmlns:c="clr-namespace:CAN_Tool.ViewModels.Converters" xmlns:op="clr-namespace:OmniProtocol" mc:Ignorable="d" d:DesignHeight="450" d:DesignWidth="800" d:DataContext="{d:DesignInstance Type=op:DeviceViewModel}">
    <UserControl.Triggers>
        <EventTrigger RoutedEvent="Loaded">
            <EventTrigger.Actions>
                <BeginStoryboard>
                    <Storyboard TargetProperty="Opacity" TargetName="ErrorString">
                        <DoubleAnimation From="0.2" To="1" AutoReverse="True" RepeatBehavior="Forever" Duration="0:0:2" />
                    </Storyboard>
                </BeginStoryboard>
            </EventTrigger.Actions>
        </EventTrigger>
    </UserControl.Triggers>
    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="150" />
            <ColumnDefinition Width="220" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="29.333" />
            <RowDefinition Height="20.667" />
            <RowDefinition Height="50" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            
        </Grid.RowDefinitions>
        <Border Grid.Column="0" Grid.Row="0" Grid.RowSpan="3" CornerRadius="15" Margin="10,15,0,15" BorderBrush="{DynamicResource MaterialDesignDivider}" BorderThickness="2" Width="120" Height="120" HorizontalAlignment="Left">
            <Border.Background>
                <ImageBrush ImageSource="{Binding Img}" Stretch="Fill" />
            </Border.Background>
        </Border>

        <TextBlock Margin="5,0,5,0" Grid.Column="1" Text="{Binding Firmware,Converter={StaticResource VersionConverter}}" VerticalAlignment="Center" FontSize="20" />
        <TextBlock Margin="5,0,5,0" Grid.Column="1" Grid.Row="1" Text="{Binding ProductionDate}" VerticalAlignment="Center" FontSize="20" />
        <TextBlock Margin="5,0,5,0" Grid.Column="1" Grid.Row="2" Text="{Binding Serial,Converter={StaticResource VersionConverter}}" VerticalAlignment="Center" FontSize="20" />
        <ProgressBar Margin="10,10,10,10" Minimum="0" Maximum="100" Grid.Column="2" Grid.Row="0" Value="{Binding ACPanelParams.CompressorPwmsSet}" Height="30"></ProgressBar>
        <ProgressBar Margin="10,10,10,10" Minimum="0" Maximum="100" Grid.Column="2" Grid.Row="1" Value="{Binding ACPanelParams.CondensorPwmSet}" Height="30"></ProgressBar>
        <ProgressBar Margin="10,10,10,10" Minimum="0" Maximum="100" Grid.Column="2" Grid.Row="2" Value="{Binding ACPanelParams.EvapoPwmSet}" Height="30"></ProgressBar>
        <TextBlock Text="{Binding ACPanelParams.CompressorPwmsSet,Mode=OneWay, StringFormat=Compressor {0}%}" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" Grid.Column="2" d:Text="45" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding ACPanelParams.CondensorPwmSet,Mode=OneWay, StringFormat=Condens.Fan {0}%}" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" Grid.Column="2" Grid.Row="1" d:Text="44" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <TextBlock Text="{Binding ACPanelParams.EvapoPwmSet,Mode=OneWay, StringFormat=Evap.Fan {0}%}" Style="{DynamicResource MaterialDesignHeadline5TextBlock}" Grid.Column="2" Grid.Row="2" d:Text="90%" VerticalAlignment="Center" HorizontalAlignment="Center" />
        <StackPanel Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="6" Orientation="Horizontal">
            <Slider x:Name="SetpointSlider" Minimum="16" Maximum="30" Height="30" Margin="0 14 0 5" ValueChanged="SetpointChanged" Width="300" />
            <TextBlock Foreground="Beige" VerticalAlignment="Center" FontSize="25" Text="{Binding ACPanelParams.Setpoint}" d:Text="15" Width="30" Margin="10"></TextBlock>
            <TextBlock x:Name="ErrorString" Text="{Binding Parameters.ErrorString}" FontSize="25" Margin="10" Foreground="PaleVioletRed" VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" Grid.Column="0" Grid.Row="3" Grid.ColumnSpan="3" Grid.RowSpan="2">
            <ListBox SelectedIndex="{Binding ACPanelParams.AcMode}">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <Button  Click="Button_Click">Off</Button>
                <Button  Click="Button_Click_1">Cool</Button>
                <Button  Click="Button_Click_2">Dry</Button>
                <Button  Click="Button_Click_3">Eco</Button>
                <Button  Click="Button_Click_4">Night</Button>
                <Button  Click="Button_Click_5">Max</Button>
                <Button  Click="Button_Click_6">Manual</Button>
                <Button >Error</Button>
            </ListBox>
            <Button Click="Button_Click_13">Clear faults</Button>
        </StackPanel>
        <ListBox Grid.Column="0" Grid.Row="5" Grid.ColumnSpan="3" SelectedIndex="{Binding ACPanelParams.AcFanMode}">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <StackPanel Orientation="Horizontal" />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <Button  Click="Button_Click_7">AUTO</Button>
            <Button  Click="Button_Click_8">1st</Button>
            <Button  Click="Button_Click_9">2nd</Button>
            <Button  Click="Button_Click_10">3rd</Button>
            <Button  Click="Button_Click_11">4th</Button>
            <Button  Click="Button_Click_12">5th</Button>
        </ListBox>
        <DataGrid Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="7"  ItemsSource="{Binding Status,Mode=OneWay}" AlternatingRowBackground="{DynamicResource MaterialDesignCardBackground}" AutoGenerateColumns="False" CanUserReorderColumns="False" SelectionMode="Single" IsReadOnly="True">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Path=Name,Mode=OneWay}"></DataGridTextColumn>
                <DataGridTextColumn Header="Value" Binding="{Binding Path=FormattedValue,Mode=OneWay}"></DataGridTextColumn>
                <DataGridTextColumn Header="Unit" Binding="{Binding Path=AssignedParameter.Unit,Mode=OneWay}"></DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
