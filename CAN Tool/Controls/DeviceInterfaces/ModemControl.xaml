<UserControl x:Class="CAN_Tool.CustomControls.ModemControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CAN_Tool.CustomControls"
             xmlns:c="clr-namespace:CAN_Tool.ViewModels.Converters"
             xmlns:op="clr-namespace:OmniProtocol"
             mc:Ignorable="d" d:DesignHeight="700" d:DesignWidth="800"
             d:DataContext="{d:DesignInstance Type=op:ModemDeviceViewModel}">
    <DockPanel>
        <local:DeviceHeaderControl DockPanel.Dock="Top" />

        <!-- Всё, что пульт реально пишет обратно в модем - см. ModemSettings.cpp/
             ModemInternetInfo::SendAutoRegisterTrigger на самом ПУ28 - в одной строке сверху.
             Auto-register - не тумблер настройки, а разовая команда, поэтому отделена
             вертикальной чертой от остальных 5 кнопок. -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="15,15,15,0">
            <WrapPanel>
                <Button Margin="0,0,10,10" Opacity="{Binding ModemParams.OnlySmsMode, Converter={StaticResource BoolToOpacity}}"
                        Click="OnlySmsModeClick" Content="{DynamicResource b_modem_only_sms}" />
                <Button Margin="0,0,10,10" Opacity="{Binding ModemParams.Force2gOnly, Converter={StaticResource BoolToOpacity}}"
                        Command="{Binding ToggleForce2gOnlyCommand}" Content="{DynamicResource b_modem_only_2g}" />
                <Button Margin="0,0,10,10" Opacity="{Binding ModemParams.AllowRoaming, Converter={StaticResource BoolToOpacity}}"
                        Command="{Binding ToggleAllowRoamingCommand}" Content="{DynamicResource b_modem_allow_roaming}" />
                <Button Margin="0,0,10,10" Opacity="{Binding ModemParams.FaultReport, Converter={StaticResource BoolToOpacity}}"
                        Click="FaultReportClick" Content="{DynamicResource b_modem_fault_report}" />
                <Button Margin="0,0,10,10" Opacity="{Binding ModemParams.CmdAck, Converter={StaticResource BoolToOpacity}}"
                        Click="CmdAckClick" Content="{DynamicResource b_modem_cmd_ack}" />
            </WrapPanel>
            <Border Width="1" Margin="5,0,15,10" Background="{DynamicResource MaterialDesignDivider}" />
            <Button Margin="0,0,10,10" VerticalAlignment="Top" Command="{Binding AutoRegisterCommand}" Content="{DynamicResource b_modem_autoregister}" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <Grid Margin="15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Левый столбец: состояние сети - только отображение, см. ModemInfo.cpp.
                     Auto, а не *, - значения тут короткие (bool/числа), не даём столбцу
                     растягиваться на половину ширины страницы вхолостую. -->
                <StackPanel Grid.Column="0" Margin="0,0,30,0">
                    <TextBlock Text="{DynamicResource t_modem_status}" FontSize="16" Opacity="0.8" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" MinWidth="60" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource t_modem_registered}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.Registered}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource t_modem_roaming}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.Roaming}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource t_modem_signal}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.Csq}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource t_modem_network}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.NetworkTech}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource t_modem_operator}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.OperatorName}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource t_modem_operator_code}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.OperatorCode}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource t_strid_imei}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.Imei}" />

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource t_modem_lac}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.Lac}" />

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="{DynamicResource t_modem_cell_id}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="8" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.CellId}" />

                        <TextBlock Grid.Row="9" Grid.Column="0" Text="{DynamicResource t_modem_temp_unit}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="9" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.TempUnitF}" />
                    </Grid>
                </StackPanel>

                <!-- Правый столбец: интернет/MQTT + последнее SMS - тоже только отображение -->
                <StackPanel Grid.Column="1">
                    <TextBlock Text="{DynamicResource t_modem_internet}" FontSize="16" Opacity="0.8" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource t_modem_internet_connected}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.InternetConnected}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource t_modem_mqtt_connected}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.MqttConnected}" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{DynamicResource t_modem_check_url}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.InternetCheckUrl}" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="{DynamicResource t_modem_broker}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.MqttBroker}" />

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="{DynamicResource t_modem_login}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="4" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.MqttLogin}" />

                        <TextBlock Grid.Row="5" Grid.Column="0" Text="{DynamicResource t_modem_password}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="5" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.MqttPassword}" />

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="{DynamicResource t_modem_connection_link}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="6" Grid.Column="1" Margin="0,4,20,4" TextTrimming="CharacterEllipsis">
                            <Hyperlink Click="ConnectionLink_Click">
                                <Run Text="{Binding ModemParams.ConnectionLink}" />
                            </Hyperlink>
                        </TextBlock>

                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{DynamicResource b_modem_autoregister}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="7" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.AutoRegStatusText}" />
                    </Grid>

                    <Separator Margin="0,15" />

                    <TextBlock Text="{DynamicResource t_modem_last_sms}" FontSize="16" Opacity="0.8" Margin="0,0,0,10" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{DynamicResource t_modem_last_sms_num}" Margin="0,4,20,4" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.LastSmsNum}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{DynamicResource t_modem_last_sms_text}" Margin="0,4,20,4" VerticalAlignment="Top" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Margin="0,4,20,4" Text="{Binding ModemParams.LastSmsText}" TextWrapping="Wrap" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </DockPanel>
</UserControl>
