<Project Sdk="Microsoft.NET.Sdk">

	
	
  <PropertyGroup>
	  <Deterministic>false</Deterministic>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.18362.0</TargetFramework>
    <RootNamespace>CAN_Tool</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
	<Nullable>disable</Nullable>
	<Platforms>AnyCPU;x86</Platforms>
	<ApplicationIcon>Images\CANTool.ico</ApplicationIcon>
	<AssemblyVersion>0.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Data\**" />
    <Compile Remove="Models\**" />
    <Compile Remove="Services\**" />
    <EmbeddedResource Remove="Data\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Services\**" />
    <None Remove="Data\**" />
    <None Remove="Models\**" />
    <None Remove="Services\**" />
    <Page Remove="Data\**" />
    <Page Remove="Models\**" />
    <Page Remove="Services\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="dll\vs_can_api.dll" />
    <None Remove="Images\CANTool.ico" />
    <None Remove="Resources\local.csv" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Resources\local.csv" />
  </ItemGroup>

  <ItemGroup>
    <DesignData Include="dll\vs_can_api.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </DesignData>
    <Content Include="Images\CANTool.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="DocX" Version="3.0.0" />
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.6.1" />
    <PackageReference Include="FontAwesome5" Version="2.1.11" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Peak.PCANBasic.NET" Version="4.10.1.968" />
    <PackageReference Include="ScottPlot.WPF" Version="4.1.71" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Images\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Resources\omnidata.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>omnidata.json</TargetPath>
    </Content>
    <Resource Include="Images\CANTool.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\DeviceInterfaces\ACPanelControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Controls\DeviceInterfaces\ACInverterControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Controls\DeviceInterfaces\ModemControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Controls\DeviceInterfaces\GenerocLoadTrippleControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Controls\DeviceInterfaces\ACInverterControl.xaml">
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

	<ItemGroup>
		<ContentWithTargetPath Include="dll\vs_can_api.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>vs_can_api.dll</TargetPath>
		</ContentWithTargetPath>
		<ContentWithTargetPath Include="dll\Candle.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Candle.dll</TargetPath>
		</ContentWithTargetPath>
	</ItemGroup>

	<PropertyGroup>
		<!-- Генерировать файл с версией сборки -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<!-- Определяем пользовательское свойство с датой компиляции -->
		<BuildDate>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm:ss"))</BuildDate>
	</PropertyGroup>

	<Target Name="SetBuildDate" BeforeTargets="CoreCompile">
		<ItemGroup>
			<AssemblyAttributes Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>BuildDate</_Parameter1>
				<_Parameter2>$(BuildDate)</_Parameter2>
			</AssemblyAttributes>
		</ItemGroup>
	</Target>

  <!--
    Inline MSBuild task: converts local.csv → lang.xaml (English/first column only).
    No external exe required. Runs before each build only when local.csv changes.
    Only lang.xaml is generated (and merged in App.xaml) as a static fallback for the
    case LocalizationLoader.Initialize() can't read the embedded local.csv at runtime -
    every other culture is loaded straight from local.csv into memory by LocalizationLoader,
    so a per-culture lang.<culture>.xaml file would just be generated and never loaded.
  -->
  <UsingTask TaskName="CsvToLangXaml"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <CsvPath      ParameterType="System.String" Required="true" />
      <OutputDir    ParameterType="System.String" Required="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System.IO" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Collections.Generic" />
      <Code Type="Fragment" Language="cs">
      <![CDATA[
        string[] lines = File.ReadAllLines(CsvPath, Encoding.UTF8);
        if (lines.Length == 0) return true;

        // Header: Key | en-En | ru-Ru | de-De | …
        string[] headers = lines[0].Split('\t');
        var cultures = new List<string>();
        for (int col = 1; col < headers.Length; col++)
            if (!string.IsNullOrWhiteSpace(headers[col]))
                cultures.Add(headers[col].Trim());

        // Collect data rows whose column count matches the header
        var items = new List<string[]>();
        for (int i = 1; i < lines.Length; i++)
        {
            string[] parts = lines[i].Split('\t');
            if (parts.Length == cultures.Count + 1)
                items.Add(parts);
            else
                items.Add(null); // keep blank separator rows
        }

        string xmlHeader =
            "<ResourceDictionary" +
            " xmlns=\"http://schemas.microsoft.com/winfx/2006/xaml/presentation\"" +
            " xmlns:x=\"http://schemas.microsoft.com/winfx/2006/xaml\"" +
            " xmlns:v=\"clr-namespace:System;assembly=mscorlib\">";

        // Только первая колонка (английский) - см. комментарий над этим таском про то,
        // почему остальные культуры сюда не пишутся.
        if (cultures.Count > 0)
        {
            var sb = new StringBuilder();
            sb.AppendLine(xmlHeader);
            foreach (string[] row in items)
            {
                if (row == null) { sb.AppendLine(); continue; }
                if (row[0].Length > 2)
                {
                    string val = row[1]
                        .Replace("&", "&amp;")
                        .Replace("<", "&lt;")
                        .Replace(">", "&gt;");
                    sb.AppendLine("<v:String x:Key=\"" + row[0] + "\">" + val + "</v:String>");
                }
                else
                    sb.AppendLine();
            }
            sb.AppendLine("</ResourceDictionary>");

            File.WriteAllText(Path.Combine(OutputDir, "lang.xaml"), sb.ToString(), Encoding.UTF8);
        }
        return true;
      ]]>
      </Code>
    </Task>
  </UsingTask>

  <!-- Runs before every build; skipped automatically when local.csv is unchanged -->
  <Target Name="GenerateLang" BeforeTargets="BeforeBuild"
          Inputs="$(ProjectDir)Resources\local.csv"
          Outputs="$(ProjectDir)Resources\lang.xaml">
    <CsvToLangXaml CsvPath="$(ProjectDir)Resources\local.csv"
                   OutputDir="$(ProjectDir)Resources\" />
    <Message Text="LocalizationLoader: lang.xaml regenerated from local.csv" Importance="high" />
  </Target>

</Project>
