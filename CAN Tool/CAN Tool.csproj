<Project Sdk="Microsoft.NET.Sdk">

	
	
  <PropertyGroup>
	  <Deterministic>false</Deterministic>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net6.0-windows10.0.18362.0</TargetFramework>
    <RootNamespace>CAN_Tool</RootNamespace>
    <UseWPF>true</UseWPF>
	<Nullable>disable</Nullable>
	<Platforms>AnyCPU;x86</Platforms>
	<ApplicationIcon>Images\CANTool.ico</ApplicationIcon>
	<AssemblyVersion>0.0.0.0</AssemblyVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="Data\**" />
    <Compile Remove="Models\**" />
    <Compile Remove="Services\**" />
    <EmbeddedResource Remove="Data\**" />
    <EmbeddedResource Remove="Models\**" />
    <EmbeddedResource Remove="Services\**" />
    <None Remove="Data\**" />
    <None Remove="Models\**" />
    <None Remove="Services\**" />
    <Page Remove="Data\**" />
    <Page Remove="Models\**" />
    <Page Remove="Services\**" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="dll\vs_can_api.dll" />
    <None Remove="Images\CANTool.ico" />
  </ItemGroup>

  <ItemGroup>
    <DesignData Include="dll\vs_can_api.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </DesignData>
    <Content Include="Images\CANTool.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.2.2" />
    <PackageReference Include="DocX" Version="3.0.0" />
    <PackageReference Include="Extended.Wpf.Toolkit" Version="4.6.1" />
    <PackageReference Include="FontAwesome5" Version="2.1.11" />
    <PackageReference Include="MaterialDesignThemes" Version="4.9.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Peak.PCANBasic.NET" Version="4.10.1.968" />
    <PackageReference Include="ScottPlot.WPF" Version="4.1.71" />
    <PackageReference Include="System.IO.Ports" Version="8.0.0" />
    <PackageReference Include="System.Text.Encoding.CodePages" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Images\*.jpg">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
    <Content Include="Resources\omnidata.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>omnidata.json</TargetPath>
    </Content>
    <Resource Include="Images\CANTool.ico" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Controls\DeviceInterfaces\ACPanelControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Controls\DeviceInterfaces\ACInverterControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Controls\DeviceInterfaces\ModemControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
    <Compile Update="Controls\DeviceInterfaces\GenerocLoadTrippleControl.xaml.cs">
      <SubType>Code</SubType>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <Page Update="Controls\DeviceInterfaces\ACInverterControl.xaml">
      <SubType>Designer</SubType>
    </Page>
    <Page Update="Resources\lang.ru-RU.xaml">
      <XamlRuntime>$(DefaultXamlRuntime)</XamlRuntime>
      <SubType>Designer</SubType>
    </Page>
  </ItemGroup>

	<ItemGroup>
		<ContentWithTargetPath Include="dll\vs_can_api.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>vs_can_api.dll</TargetPath>
		</ContentWithTargetPath>
		<ContentWithTargetPath Include="dll\Candle.dll">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<TargetPath>Candle.dll</TargetPath>
		</ContentWithTargetPath>
	</ItemGroup>

	<PropertyGroup>
		<!-- Генерировать файл с версией сборки -->
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<!-- Определяем пользовательское свойство с датой компиляции -->
		<BuildDate>$([System.DateTime]::Now.ToString("yyyy-MM-dd HH:mm:ss"))</BuildDate>
	</PropertyGroup>

	<Target Name="SetBuildDate" BeforeTargets="CoreCompile">
		<ItemGroup>
			<AssemblyAttributes Include="System.Reflection.AssemblyMetadataAttribute">
				<_Parameter1>BuildDate</_Parameter1>
				<_Parameter2>$(BuildDate)</_Parameter2>
			</AssemblyAttributes>
		</ItemGroup>
	</Target>
	<Target Name="GenerateLang" BeforeTargets="Build" Inputs="Resources\local.csv" Outputs="Resources\lang.xaml">
		<Exec Command="&quot;$(ProjectDir)Resources\Localizator.exe&quot; &quot;$(ProjectDir)Resources\local.csv&quot; &quot;$(ProjectDir)Resources\&quot;" />
	</Target>
</Project>
